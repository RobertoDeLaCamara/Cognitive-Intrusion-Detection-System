# ── Capture ────────────────────────────────────────────────────────────────────
CAPTURE_INTERFACE=         # leave empty for auto-detect
PACKET_WORKERS=4
PACKET_QUEUE_SIZE=20000

# ── Detection ──────────────────────────────────────────────────────────────────
FLOW_TIMEOUT=120
MAX_ACTIVE_FLOWS=50000
ACTIVE_IDLE_THRESH=1.0     # seconds of inactivity to mark a flow idle
HOST_WINDOW_SIZE=100       # packet history window per IP
MAX_TRACKED_IPS=5000       # max IPs tracked by host extractor / LSTM / decay caches
MIN_PACKETS_FOR_ML=10
LARGE_PAYLOAD_BYTES=10000
MAX_PAYLOAD_SAMPLES=50     # max payload samples stored per flow
PAYLOAD_SAMPLE_BYTES=4096  # max bytes kept per payload sample

# ── Rule thresholds ───────────────────────────────────────────────────────────
RATE_SPIKE_MULTIPLIER=2.0
ICMP_FLOOD_THRESHOLD=50
PORT_SCAN_THRESHOLD=20
ALERT_COOLDOWN_SECS=60

# ── Engine weights (must sum to 1.0) ──────────────────────────────────────────
WEIGHT_SUPERVISED=0.40
WEIGHT_IFOREST=0.30
WEIGHT_LSTM=0.20
WEIGHT_RULES=0.10
ENSEMBLE_THRESHOLD=0.55

# ── Per-attack-type weight overrides (Phase 4) ────────────────────────────────
# JSON: {"DoS": {"supervised": 0.6, "rules": 0.2}}
ATTACK_TYPE_WEIGHTS={}
CALIBRATION_TEMPERATURE=1.0   # >1 = softer scores, <1 = sharper

# ── Model paths ────────────────────────────────────────────────────────────────
MODELS_DIR=models
RF_MODEL_FILE=rf_model.joblib
IF_MODEL_FILE=isolation_forest.joblib
IF_SCALER_FILE=if_scaler.joblib
LSTM_MODEL_FILE=lstm_autoencoder.pt
LSTM_CONFIG_FILE=lstm_config.json

# ── MLflow (Phase 5) ──────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=       # empty = disabled; e.g. http://localhost:5000
MLFLOW_REGISTRY_NAME=cnds

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./cnds.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cnds

# ── API ────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=                   # leave empty to disable API-key auth
CORS_ORIGINS=              # comma-separated origins; empty defaults to http://localhost:3000

# ── JWT Auth (Phase 7) ────────────────────────────────────────────────────────
JWT_SECRET=                # leave empty to disable JWT auth
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Observability (Phase 7) ───────────────────────────────────────────────────
PROMETHEUS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=   # e.g. http://localhost:4317

# ── GeoIP enrichment (Phase 8) ────────────────────────────────────────────────
GEOIP_DB_PATH=             # path to GeoLite2-City.mmdb; empty = disabled

# ── Alert correlation (Phase 8) ───────────────────────────────────────────────
CORRELATION_WINDOW_SECS=300
CORRELATION_THRESHOLD=5    # alerts from same IP before auto-incident

# ── Adaptive weights (Phase 8) ────────────────────────────────────────────────
ADAPTIVE_WEIGHTS_ENABLED=false
ADAPTIVE_MIN_SAMPLES=100   # min acknowledged alerts before adapting

# ── Notifications (Phase 8) ───────────────────────────────────────────────────
WEBHOOK_URLS=              # comma-separated webhook/Slack URLs
NOTIFY_MIN_SEVERITY=high   # minimum severity to trigger notification
TELEGRAM_BOT_TOKEN=        # Telegram bot token from @BotFather; empty = disabled
TELEGRAM_CHAT_ID=          # Telegram chat/group ID to send alerts to

# ── Rate limiting (Phase 8) ───────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=60     # max requests per window per IP
RATE_LIMIT_WINDOW=60       # window in seconds

# ── DNS logging (Phase 8) ─────────────────────────────────────────────────────
DNS_LOGGING_ENABLED=false

# ── Alert deduplication ────────────────────────────────────────────────────────
DEDUP_WINDOW_SECS=300      # suppress duplicate (src_ip, attack_type) alerts within this window

# ── Confidence decay (Phase 9) ────────────────────────────────────────────────
CONFIDENCE_DECAY_FACTOR=0.9   # multiplier per repeat alert (0.9 = 10% reduction each)
CONFIDENCE_DECAY_WINDOW=300   # seconds to track repeats

# ── IP allowlist / blocklist (Phase 9) ────────────────────────────────────────
IP_ALLOWLIST=              # comma-separated IPs to skip detection entirely
IP_BLOCKLIST=              # comma-separated IPs to auto-flag

# ── Device profiles — trusted outbound domains ────────────────────────────────
# JSON: per-device src_ip → list of trusted dst domain suffixes.
# Flows from that IP whose dst resolves to a listed suffix are skipped before
# the detection pipeline runs. Use for known-benign cloud traffic (e.g. NAS
# QuickConnect relay, printer telemetry, smart TV heartbeats).
# Synology NAS example (QuickConnect relay + DSM cloud services):
# TRUSTED_OUTBOUND={"192.168.1.60": ["synology.com", "quickconnect.to", "synology.cn"]}
TRUSTED_OUTBOUND={}

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_FORMAT=text            # "text" or "json" (structured, for ELK/Loki/CloudWatch)

# ── JA3 TLS fingerprinting ────────────────────────────────────────────────────
JA3_ENABLED=true           # extract JA3 hashes from TLS ClientHello
MALICIOUS_JA3_FILE=        # path to known-bad JA3 hashes (one per line); empty = none
