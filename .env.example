# ── Capture ────────────────────────────────────────────────────────────────────
# Leave CAPTURE_INTERFACE empty for auto-detect
CAPTURE_INTERFACE=
PACKET_WORKERS=4
PACKET_QUEUE_SIZE=20000

# ── Detection ──────────────────────────────────────────────────────────────────
FLOW_TIMEOUT=120
MAX_ACTIVE_FLOWS=50000
# Seconds of inactivity to mark a flow idle
ACTIVE_IDLE_THRESH=1.0
# Packet history window per IP
HOST_WINDOW_SIZE=100
# Max IPs tracked by host extractor / LSTM / decay caches
MAX_TRACKED_IPS=5000
MIN_PACKETS_FOR_ML=10
LARGE_PAYLOAD_BYTES=10000
# Max payload samples stored per flow
MAX_PAYLOAD_SAMPLES=50
# Max bytes kept per payload sample
PAYLOAD_SAMPLE_BYTES=4096

# ── Rule thresholds ───────────────────────────────────────────────────────────
RATE_SPIKE_MULTIPLIER=2.0
ICMP_FLOOD_THRESHOLD=50
PORT_SCAN_THRESHOLD=20
ALERT_COOLDOWN_SECS=60

# ── Engine weights (must sum to 1.0) ──────────────────────────────────────────
# Five engines: supervised + iforest + lstm + rules + baseline must equal 1.0
WEIGHT_SUPERVISED=0.35
WEIGHT_IFOREST=0.25
WEIGHT_LSTM=0.15
WEIGHT_RULES=0.05
WEIGHT_BASELINE=0.20
ENSEMBLE_THRESHOLD=0.55

# ── Per-attack-type weight overrides (Phase 4) ────────────────────────────────
# JSON: {"DoS": {"supervised": 0.6, "rules": 0.2}}
ATTACK_TYPE_WEIGHTS={}
# >1 = softer scores, <1 = sharper
CALIBRATION_TEMPERATURE=1.0

# ── Model paths ────────────────────────────────────────────────────────────────
MODELS_DIR=models
RF_MODEL_FILE=rf_model.joblib
IF_MODEL_FILE=isolation_forest.joblib
IF_SCALER_FILE=if_scaler.joblib
LSTM_MODEL_FILE=lstm_autoencoder.pt
LSTM_CONFIG_FILE=lstm_config.json

# ── Unified FT-Transformer ────────────────────────────────────────────────────
# Temperature scaling applied to logits before softmax.
# T > 1 reduces over-confidence (transformers are typically over-confident).
# T=1.0 disables scaling. Tune empirically; 2.0 is a reasonable starting point.
FT_TEMPERATURE=2.0
FT_SCORE_THRESHOLD=0.50

# ── MLflow (Phase 5) ──────────────────────────────────────────────────────────
# Homelab MLflow server; empty = disabled (local file fallback)
MLFLOW_TRACKING_URI=http://your-mlflow-host:5050
MLFLOW_REGISTRY_NAME=cnds
# MinIO artifact store credentials (required for model artifact upload/download)
AWS_ACCESS_KEY_ID=your-minio-access-key
AWS_SECRET_ACCESS_KEY=your-minio-secret-key
MLFLOW_S3_ENDPOINT_URL=http://your-minio-host:9000

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./cnds.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cnds

# Required by docker-compose.yml (api/detector/postgres services) — compose
# refuses to start without it, there is no insecure built-in default. Not
# used by the sqlite DATABASE_URL above.
POSTGRES_PASSWORD=

# ── API ────────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# The API refuses to start unless API_KEY or JWT_SECRET is set, or AUTH_DISABLED=true
API_KEY=
# AUTH_DISABLED=false   # set to true ONLY for lab/local use (runs the API with no auth)
# Comma-separated origins; empty defaults to http://localhost:3000
CORS_ORIGINS=

# ── JWT Auth (Phase 7) ────────────────────────────────────────────────────────
# Preferred auth. If empty, API_KEY or AUTH_DISABLED=true is required
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Observability (Phase 7) ───────────────────────────────────────────────────
PROMETHEUS_ENABLED=false
# Optional: require "Authorization: Bearer <token>" on /metrics (leave empty for a public endpoint).
METRICS_TOKEN=
# e.g. http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── GeoIP enrichment (Phase 8) ────────────────────────────────────────────────
# Path to GeoLite2-City.mmdb; empty = disabled
GEOIP_DB_PATH=

# ── Alert correlation (Phase 8) ───────────────────────────────────────────────
CORRELATION_WINDOW_SECS=300
# Alerts from same IP before auto-incident
CORRELATION_THRESHOLD=5

# ── Adaptive weights (Phase 8) ────────────────────────────────────────────────
ADAPTIVE_WEIGHTS_ENABLED=false
# Min acknowledged alerts before adapting
ADAPTIVE_MIN_SAMPLES=100

# ── Notifications (Phase 8) ───────────────────────────────────────────────────
# Comma-separated webhook/Slack URLs
WEBHOOK_URLS=
# Minimum severity to trigger notification
NOTIFY_MIN_SEVERITY=high
# ntfy push notifications; empty NTFY_URL = disabled. Use a write-only user or an access token.
NTFY_URL=
NTFY_TOPIC=cnds
NTFY_USER=
NTFY_PASSWORD=
NTFY_TOKEN=
# Dashboard base URL: ntfy notifications get a tap-to-open link to the alert detail page
DASHBOARD_URL=
# Telegram bot token from @BotFather; empty = disabled
TELEGRAM_BOT_TOKEN=
# Telegram chat/group ID to send alerts to
TELEGRAM_CHAT_ID=
# Users allowed to press Confirm/Undo (comma-separated Telegram user IDs). Leave empty for a
# private chat; REQUIRED when TELEGRAM_CHAT_ID is a group (negative ID), otherwise nobody can.
TELEGRAM_ALLOWED_USER_IDS=

# ── Rate limiting (Phase 8) ───────────────────────────────────────────────────
# Max requests per window per IP
RATE_LIMIT_REQUESTS=60
# Window in seconds
RATE_LIMIT_WINDOW=60

# ── DNS logging (Phase 8) ─────────────────────────────────────────────────────
DNS_LOGGING_ENABLED=false

# ── Alert deduplication ────────────────────────────────────────────────────────
# Suppress duplicate (src_ip, attack_type) alerts within this window
DEDUP_WINDOW_SECS=300

# ── Confidence decay (Phase 9) ────────────────────────────────────────────────
# Multiplier per repeat alert (0.9 = 10% reduction each)
CONFIDENCE_DECAY_FACTOR=0.9
# Seconds to track repeats
CONFIDENCE_DECAY_WINDOW=300

# ── IP allowlist / blocklist (Phase 9) ────────────────────────────────────────
# Comma-separated IPs or CIDR ranges to skip detection entirely (e.g. 10.0.0.1,192.168.0.0/16)
IP_ALLOWLIST=
# Comma-separated IPs or CIDR ranges to auto-flag as critical
IP_BLOCKLIST=

# ── Device profiles — trusted outbound domains ────────────────────────────────
# JSON: per-device src_ip → list of trusted dst domain suffixes.
# Flows from that IP whose dst resolves to a listed suffix are skipped before
# the detection pipeline runs. Use for known-benign cloud traffic (e.g. NAS
# QuickConnect relay, printer telemetry, smart TV heartbeats).
# Synology NAS example (QuickConnect relay + DSM cloud services):
# TRUSTED_OUTBOUND={"192.168.1.x": ["synology.com", "quickconnect.to", "synology.cn"]}
TRUSTED_OUTBOUND={}

# ── Logging ────────────────────────────────────────────────────────────────────
# "text" or "json" (structured, for ELK/Loki/CloudWatch)
LOG_FORMAT=text

# ── JA3 TLS fingerprinting ────────────────────────────────────────────────────
# Extract JA3 hashes from TLS ClientHello
JA3_ENABLED=true
# Path to known-bad JA3 hashes (one per line); empty = none
MALICIOUS_JA3_FILE=

# ── Threat Intelligence Feeds ─────────────────────────────────────────────────
# AbuseIPDB API (https://www.abuseipdb.com/): leave empty to disable
ABUSEIPDB_URL=https://api.abuseipdb.com/api/v2/blacklist
ABUSEIPDB_API_KEY=
# URL to fetch known-malicious JA3 hashes (one per line); empty to disable
MALICIOUS_JA3_URL=https://raw.githubusercontent.com/strangerealintel/ja3-fingerprints/main/ja3-hashes.txt
# MISP instance (optional)
MISP_URL=
MISP_API_KEY=
# How often to refresh threat intel feeds (minutes)
THREAT_INTEL_REFRESH_MINUTES=60

# ── Guardian auto-response ────────────────────────────────────────────────────
# Master switch. Leave false until you've reviewed GUARDIAN_WHITELIST below.
GUARDIAN_ENABLED=false
# Minimum alert severity that triggers an auto-block: low/medium/high/critical
GUARDIAN_MIN_SEVERITY=critical
# Which alert sources the guardian may act on: detector (capture pipeline) and/or api (POST /api/predict).
# Keep detector-only so a /api/predict caller cannot get a LAN host blocked.
GUARDIAN_ALERT_SOURCES=detector
GUARDIAN_POLL_INTERVAL_SECS=15
# How long an auto-block lasts before it's automatically rolled back
GUARDIAN_BLOCK_MINUTES=30
# IMPORTANT: comma-separated IPs/CIDRs the guardian will NEVER block.
# Defaults only cover the gateway and this host — add every device you own
# (phones, laptops, etc.) before setting GUARDIAN_ENABLED=true, or a false
# positive could lock you out of your own network.
GUARDIAN_WHITELIST=192.168.1.1,192.168.1.62
# Storm protection: pause auto-blocking after this many actions in the window
GUARDIAN_CIRCUIT_MAX_ACTIONS=5
GUARDIAN_CIRCUIT_WINDOW_SECS=600
# AdGuard Home enforcement backend (DNS-level blocking)
ADGUARD_URL=http://192.168.1.62:8001
ADGUARD_USERNAME=
ADGUARD_PASSWORD=

# ── Triage agent (MCP roadmap phase 2) — python -m src.triage ────────────────
# Annotates alerts with an advisory verdict. Never acknowledges or mitigates.
# workflow = context in the prompt, no tools (default) | agent = read-only cnds MCP tools
TRIAGE_MODE=workflow
TRIAGE_MIN_SEVERITY=high
TRIAGE_LOOKBACK_HOURS=24
TRIAGE_BATCH_SIZE=10
# Below this confidence the stored verdict becomes needs_human
TRIAGE_MIN_CONFIDENCE=0.6
# Spend caps (client-side estimates from the CLI)
TRIAGE_MAX_USD_PER_ALERT=0.25
TRIAGE_DAILY_BUDGET_USD=2.0
TRIAGE_MAX_TURNS=8
TRIAGE_TIMEOUT_SECS=180
TRIAGE_POLL_INTERVAL_SECS=300
TRIAGE_CLAUDE_BIN=claude
TRIAGE_CLAUDE_MODEL=
# --bare needs ANTHROPIC_API_KEY (API billing). Set false to use the CLI's own login.
TRIAGE_CLAUDE_BARE=true
# Agent mode only: path to an MCP config registering the read-only cnds server
TRIAGE_MCP_CONFIG=
