# ═══════════════════════════════════════════════════════════════════════════════
# .env.sandbox — Configuration for the CNDS Network Sandbox
# ═══════════════════════════════════════════════════════════════════════════════
# Tuned for demo/testing: lower thresholds, faster reactions, Guardian enabled.
# Used by: docker compose -f docker-compose.sandbox.yml up --build

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=sandbox_secret

# ── Capture ───────────────────────────────────────────────────────────────────
# Detector captures on eth0 (the homenet bridge interface)
CAPTURE_INTERFACE=eth0
PACKET_WORKERS=4
PACKET_QUEUE_SIZE=10000

# ── Detection (lowered thresholds for demo) ───────────────────────────────────
FLOW_TIMEOUT=30
MAX_ACTIVE_FLOWS=10000
ACTIVE_IDLE_THRESH=1.0
HOST_WINDOW_SIZE=50
MAX_TRACKED_IPS=500
MIN_PACKETS_FOR_ML=3
LARGE_PAYLOAD_BYTES=5000
MAX_PAYLOAD_SAMPLES=30
PAYLOAD_SAMPLE_BYTES=4096

# ── Rule thresholds (lower for sandbox — attacks trigger faster) ──────────────
RATE_SPIKE_MULTIPLIER=1.5
ICMP_FLOOD_THRESHOLD=20
PORT_SCAN_THRESHOLD=10
ALERT_COOLDOWN_SECS=15
DEDUP_WINDOW_SECS=60

# ── Ensemble (lower threshold → more alerts in demo) ──────────────────────────
WEIGHT_SUPERVISED=0.35
WEIGHT_IFOREST=0.25
WEIGHT_LSTM=0.15
WEIGHT_RULES=0.05
WEIGHT_BASELINE=0.20
ENSEMBLE_THRESHOLD=0.40
CALIBRATION_TEMPERATURE=1.0
ATTACK_TYPE_WEIGHTS={}

# ── Models ────────────────────────────────────────────────────────────────────
MODELS_DIR=models
RF_MODEL_FILE=rf_model.joblib
RF_LITE_MODEL_FILE=rf_lite_model.joblib
IF_MODEL_FILE=isolation_forest.joblib
IF_SCALER_FILE=if_scaler.joblib
LSTM_MODEL_FILE=lstm_autoencoder.pt
LSTM_CONFIG_FILE=lstm_config.json
FT_TEMPERATURE=2.0
FT_SCORE_THRESHOLD=0.40

# ── MLflow (disabled for sandbox) ─────────────────────────────────────────────
MLFLOW_TRACKING_URI=
MLFLOW_REGISTRY_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MLFLOW_S3_ENDPOINT_URL=

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ── JWT (disabled for sandbox simplicity) ─────────────────────────────────────
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Observability ─────────────────────────────────────────────────────────────
PROMETHEUS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_FORMAT=text

# ── Alert enrichment ──────────────────────────────────────────────────────────
GEOIP_DB_PATH=
CORRELATION_WINDOW_SECS=120
CORRELATION_THRESHOLD=3
ADAPTIVE_WEIGHTS_ENABLED=false
ADAPTIVE_MIN_SAMPLES=20
CONFIDENCE_DECAY_FACTOR=0.9
CONFIDENCE_DECAY_WINDOW=120

# ── Notifications (disabled — use dashboard to observe) ───────────────────────
WEBHOOK_URLS=
NOTIFY_MIN_SEVERITY=high
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Rate limiting (relaxed for sandbox) ───────────────────────────────────────
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW=60

# ── DNS + JA3 ─────────────────────────────────────────────────────────────────
DNS_LOGGING_ENABLED=true
JA3_ENABLED=true
MALICIOUS_JA3_FILE=

# ── IP lists ──────────────────────────────────────────────────────────────────
# Attacker is on the blocklist → always flagged as critical
IP_ALLOWLIST=
IP_BLOCKLIST=172.20.0.66

# ── Threat Intelligence (disabled in sandbox) ─────────────────────────────────
ABUSEIPDB_URL=
ABUSEIPDB_API_KEY=
MALICIOUS_JA3_URL=
MISP_URL=
MISP_API_KEY=
THREAT_INTEL_REFRESH_MINUTES=60

# ── Baseline training (enabled — sandbox generates enough traffic) ─────────────
BASELINE_COLLECTION_ENABLED=true

# ── Guardian auto-response ────────────────────────────────────────────────────
GUARDIAN_ENABLED=true
GUARDIAN_MIN_SEVERITY=high
GUARDIAN_POLL_INTERVAL_SECS=5
GUARDIAN_BLOCK_MINUTES=5
# Whitelist: AdGuard, detector, and legitimate clients — NOT the attacker
GUARDIAN_WHITELIST=172.20.0.2,172.20.0.3,172.20.0.10,172.20.0.11,172.20.0.12
GUARDIAN_CIRCUIT_MAX_ACTIONS=10
GUARDIAN_CIRCUIT_WINDOW_SECS=300

# ── AdGuard Home (enforcement backend for Guardian) ───────────────────────────
ADGUARD_URL=http://172.20.0.2:3000
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=sandbox123

# ── Device profiles ───────────────────────────────────────────────────────────
TRUSTED_OUTBOUND={}
