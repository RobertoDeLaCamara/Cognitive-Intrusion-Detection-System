# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# Model files (large binaries — train locally or pull from MLflow).
# Patterns use ** so artifacts under models/unified/ are also excluded.
models/**/*.joblib
models/**/*.pkl
models/**/*.pt
# Exceptions: lite RF model ships with the repo for out-of-the-box detection.
!models/rf_lite_model.joblib
# Keep metadata JSON files (small) — feature names, class labels, etc.
!models/**/*.json

# Local MLflow artifact cache (created when running scripts/notebooks
# without a remote tracking URI configured).
mlruns/

# Database
*.db
*.sqlite3

# Environment
.env

# IDE
.idea/
.vscode/
*.swp

.claude/settings.local.json
