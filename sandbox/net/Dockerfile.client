# Dockerfile.client — Lightweight traffic generator simulating home devices.
# Uses Python + standard network tools to produce realistic benign traffic.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget dnsutils iputils-ping netcat-openbsd iproute2 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir httpx==0.27.0

WORKDIR /app
COPY client_traffic.py .

CMD ["python", "-u", "client_traffic.py"]
